generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  name                    String
  password                String
  role                    UserRole
  phone                   String?
  avatar                  String?
  isActive                Boolean           @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  mustChangePassword      Boolean           @default(true) @map("must_change_password")
  auditLogs               AuditLog[]
  complaintUpdates        ComplaintUpdate[]
  wardenHostels           Hostel[]          @relation("WardenToHostel")
  notifications           Notification[]
  studentProfile          StudentProfile?
  supportMessagesReceived SupportMessage[]  @relation("SupportMessagesReceived")
  supportMessagesSent     SupportMessage[]  @relation("SupportMessagesSent")

  @@map("users")
}

model SupportMessage {
  messageId   String         @id @default(uuid()) @map("message_id")
  complaintId String         @map("complaint_id")
  studentId   String         @map("student_id")
  senderId    String         @map("sender_id")
  senderRole  ChatSenderRole @map("sender_role")
  recipientId String         @map("recipient_id")
  content     String
  contentType String         @default("TEXT") @map("content_type")
  timestamp   DateTime       @default(now())
  readStatus  Boolean        @default(false) @map("read_status")
  complaint   Complaint      @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  recipient   User           @relation("SupportMessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User           @relation("SupportMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([complaintId, timestamp(sort: Desc)])
  @@index([studentId, timestamp(sort: Desc)])
  @@index([recipientId, readStatus])
  @@map("support_messages")
}

model StudentProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  studentId       String      @unique
  academicProgram String?
  roomId          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  assignedRoom    String?     @map("assigned_room")
  complaints      Complaint[]
  room            Room?       @relation(fields: [roomId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Hostel {
  id         String      @id @default(cuid())
  name       String      @unique
  wardenId   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  complaints Complaint[]
  warden     User        @relation("WardenToHostel", fields: [wardenId], references: [id])
  rooms      Room[]

  @@map("hostels")
}

model Room {
  id              String           @id @default(cuid())
  roomNumber      String
  floor           Int
  hostelId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  complaints      Complaint[]
  hostel          Hostel           @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  studentProfiles StudentProfile[]

  @@unique([roomNumber, hostelId])
  @@map("rooms")
}

model Complaint {
  id               String            @id @default(cuid())
  title            String
  description      String
  locationBlock    String?
  category         String
  status           Status            @default(PENDING)
  isAnonymous      Boolean           @default(false)
  resolvedAt       DateTime?
  closedAt         DateTime?
  studentProfileId String?
  roomId           String
  hostelId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  priority         Priority          @default(ROUTINE)
  complaintUpdates ComplaintUpdate[]
  hostel           Hostel            @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room             Room              @relation(fields: [roomId], references: [id])
  studentProfile   StudentProfile?   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  evidences        Evidence[]
  notifications    Notification[]
  supportMessages  SupportMessage[]

  @@map("complaints")
}

model ComplaintUpdate {
  id          String    @id @default(cuid())
  content     String
  complaintId String
  updatedById String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  updatedBy   User      @relation(fields: [updatedById], references: [id])

  @@map("complaint_updates")
}

model Evidence {
  id                   String    @id @default(cuid())
  fileUrl              String
  fileType             String
  complaintId          String
  aiVerified           Boolean   @default(true) @map("ai_verified")
  manualReviewRequired Boolean   @default(false) @map("manual_review_required")
  complaint            Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@map("evidences")
}

model Notification {
  id          String    @id @default(cuid())
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  userId      String
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AdminCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admin_categories")
}

model AdminDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_departments")
}

model AdminSlaSetting {
  id                    String   @id @default("default")
  updatedAt             DateTime @updatedAt
  reminderFrequencyDays Int      @default(14)
  safeThresholdDays     Int      @default(14)
  warningThresholdDays  Int      @default(30)
  emergencyTargetHours  Int      @default(4)
  routineTargetHours    Int      @default(72)
  urgentTargetHours     Int      @default(24)

  @@map("admin_sla_settings")
}

model AdminEmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  html      String
  updatedAt DateTime @updatedAt

  @@map("admin_email_templates")
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  action    String
  resource  String
  before    String?
  after     String?
  ipAddress String?
  userName  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model ComplaintEmbedding {
  id              String   @id @default(cuid())
  complaintId     String   @unique @map("complaint_id")
  category        String
  hostelBlock     String?  @map("hostel_block")
  hostelName      String   @map("hostel_name")
  descriptionSnap String   @map("description_snap")
  resolutionSnap  String?  @map("resolution_snap")
  embeddedAt      DateTime @default(now()) @map("embedded_at")

  @@map("complaint_embeddings")
}

model PolicyChunk {
  id         String   @id @default(cuid())
  sectionRef String   @map("section_ref")
  category   String?
  title      String
  content    String
  embeddedAt DateTime @default(now()) @map("embedded_at")

  @@map("policy_chunks")
}

enum Status {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserRole {
  STUDENT
  MANAGEMENT
  IT_STAFF_ADMIN @map("IT STAFF/ADMIN")
}

enum Priority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum ChatSenderRole {
  STUDENT
  MANAGEMENT
}

// ─── RAG: Document Vault ──────────────────────────────────────────────────────

model RagDocument {
  id             String             @id @default(cuid())
  title          String
  fileName       String             @map("file_name")
  fileKey        String             @map("file_key")
  mimeType       String             @map("mime_type")
  fileSize       Int                @map("file_size")
  pageCount      Int?               @map("page_count")
  status         String             @default("PROCESSING")
  errorMessage   String?            @map("error_message")
  uploadedById   String             @map("uploaded_by_id")
  uploadedByRole String             @map("uploaded_by_role")
  chunkCount     Int                @default(0) @map("chunk_count")
  chunks         RagDocumentChunk[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@map("rag_documents")
}

model RagDocumentChunk {
  id          String      @id @default(cuid())
  document    RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId  String      @map("document_id")
  chunkIndex  Int         @map("chunk_index")
  content     String      @db.Text
  embeddedAt  DateTime?   @map("embedded_at")

  @@index([documentId])
  @@map("rag_document_chunks")
}
