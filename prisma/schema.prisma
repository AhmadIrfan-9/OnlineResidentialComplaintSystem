// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

enum ComplaintCategory {
  PLUMBING
  WIFI
  ELECTRIC
  CLEANING
  FURNITURE
  MAINTENANCE
  NOISE
  SECURITY
  OTHER
}

enum Status {
  SUBMITTED
  ACKNOWLEDGED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum Priority {
  ROUTINE
  URGENT
  EMERGENCY
}

enum UserRole {
  STUDENT
  MANAGEMENT
  IT_STAFF_ADMIN @map("IT STAFF/ADMIN")
}

// User model - represents all user types (Students, Wardens, Staff)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole
  phone     String?
  avatar    String?

  // Relations
  studentProfile   StudentProfile?
  wardenHostels    Hostel[]  @relation("WardenToHostel")
  complaintUpdates ComplaintUpdate[]
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// StudentProfile model - extends User with student-specific data
model StudentProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  // Student's current room assignment
  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  // Relations
  complaints Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

// Hostel model - represents a student residence
model Hostel {
  id   String @id @default(cuid())
  name String @unique

  // Warden managing this hostel
  warden   User   @relation("WardenToHostel", fields: [wardenId], references: [id])
  wardenId String

  // Relations
  rooms      Room[]
  complaints Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hostels")
}

// Room model - represents a room within a hostel
model Room {
  id         String @id @default(cuid())
  roomNumber String
  floor      Int

  // Links to hostel
  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId String

  // Relations
  studentProfiles StudentProfile[]
  complaints      Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomNumber, hostelId])
  @@map("rooms")
}

// Complaint model - represents a student complaint
model Complaint {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  category    ComplaintCategory
  status      Status   @default(SUBMITTED)
  priority    Priority @default(ROUTINE)
  studentId   Int?
  isAnonymous Boolean  @default(false)
  resolvedAt  DateTime?
  closedAt    DateTime?

  // Relations
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  studentProfileId String?

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  hostel   Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  hostelId String

  complaintUpdates ComplaintUpdate[]
  evidences        Evidence[]
  notifications    Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("complaints")
}

// ComplaintUpdate model - tracks comments and status changes
model ComplaintUpdate {
  id      String @id @default(cuid())
  content String @db.Text

  // Relations
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId String

  updatedBy   User   @relation(fields: [updatedById], references: [id])
  updatedById String

  createdAt DateTime @default(now())

  @@map("complaint_updates")
}

model Evidence {
  id       String @id @default(cuid())
  fileUrl  String
  fileType String

  // Relations
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId String

  @@map("evidences")
}

model Notification {
  id        String   @id @default(cuid())
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  complaintId String

  @@map("notifications")
}
